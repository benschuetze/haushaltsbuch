{
  "name": "haushaltsbuch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:quick": "pnpm typecheck && pnpm lint && pnpm test",
    "check": "pnpm check:quick && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "eval": "tsx evals/run.ts",
    "db:local": "tsx scripts/local-db.ts",
    "smoke:ai": "tsx scripts/smoke-ai.ts",
    "smoke:bank": "tsx scripts/smoke-bank.ts",
    "security:osv": "tsx scripts/osv-check.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@sentry/node": "10.75.3",
    "ai": "^7.0.155",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "5.11.2",
    "isbot": "^5.2.2",
    "lucide-react": "^1.62.0",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
