# Neon (Region Frankfurt), pooled connection string
DATABASE_URL=

# LLM für die Kategorisierung
ANTHROPIC_API_KEY=
# günstiges Modell, Standard: claude-haiku-5-5
AI_MODEL=
# 1 = festes Stichwort-Modell statt echtem LLM (Tests, Demo ohne API-Key)
AI_MOCK=

# Login für die private Instanz
APP_PASSWORD=
SESSION_SECRET=

# true auf der öffentlichen Demo-Instanz: nur lesen, Beispieldaten werden beim Build importiert
DEMO_MODE=false
