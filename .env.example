# Neon (Region Frankfurt), pooled connection string
DATABASE_URL=

# LLM für die Kategorisierung
ANTHROPIC_API_KEY=
# nur nötig, wenn der Key für mehrere Workspaces gilt (Konsole → Arbeitsbereiche → ID)
ANTHROPIC_WORKSPACE_ID=
# günstiges Modell, Standard: claude-haiku-5-5
AI_MODEL=
# 1 = festes Stichwort-Modell statt echtem LLM (Tests, Demo ohne API-Key)
AI_MOCK=
# 1 = Assistent spricht trotz AI_MOCK mit dem echten Modell (öffentliche Demo), braucht ANTHROPIC_API_KEY
ASSISTANT_LIVE=
# Fragen an den Assistenten pro Tag, Standard 60
ASSISTANT_DAILY_LIMIT=

# Login für die private Instanz
APP_PASSWORD=
SESSION_SECRET=

# true auf der öffentlichen Demo-Instanz: nur lesen, Beispieldaten werden beim Build importiert
DEMO_MODE=false

# Bankanbindung über Enable Banking (leer = aus). Privater Schlüssel als PEM oder base64 in einer Zeile.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# 32 Byte, base64 (openssl rand -base64 32): verschlüsselt die Bank-Zugangsdaten in der Datenbank
DATA_ENCRYPTION_KEY=
# mindestens 32 Zeichen (openssl rand -hex 32): schützt den täglichen Abruf (Vercel Cron)
CRON_SECRET=
# Betreiber für Impressum und Datenschutz; nur in der Hosting-Umgebung setzen, nie ins Repo
PRIVACY_OPERATOR=
# Anschrift, Teile mit ; getrennt: Straße Nr.;PLZ Ort
OPERATOR_ADDRESS=
PRIVACY_CONTACT_EMAIL=
